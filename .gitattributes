# ============================================================
# ApexFormula — Git attributes
# Git LFS is configured now so that no binary asset is ever
# committed to plain Git history. See DECISION_LOG.md D-022.
# No binary files exist at Milestone 0A; these rules are
# pre-emptive and take effect from Milestone 0B onward.
# ============================================================

# ------------------------------------------------------------
# Line endings — Windows is the development platform
# ------------------------------------------------------------
* text=auto
*.md   text eol=lf
*.py   text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.cs   text eol=lf
*.ini  text eol=lf
*.json text eol=lf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# ------------------------------------------------------------
# Unreal Engine binary assets
# ------------------------------------------------------------
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------
# 3D interchange formats
# ------------------------------------------------------------
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.abc   filter=lfs diff=lfs merge=lfs -text
*.usd   filter=lfs diff=lfs merge=lfs -text
*.usda  filter=lfs diff=lfs merge=lfs -text
*.usdc  filter=lfs diff=lfs merge=lfs -text
*.usdz  filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------
# Blender source files
# ------------------------------------------------------------
*.blend filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------
# Textures and images
